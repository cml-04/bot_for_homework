# Dockerfile for worker node (Linux servers)
FROM python:3.9-slim

# Install system dependencies
RUN apt-get update && apt-get install -y \
    gcc \
    g++ \
    openssh-client \
    curl \
    htop \
    && rm -rf /var/lib/apt/lists/*

# Set working directory
WORKDIR /app

# Copy requirements and install Python dependencies
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# Copy application code
COPY distributed_ga/ ./distributed_ga/

# Create directories for temporary files and logs
RUN mkdir -p /app/tmp /app/logs

# Set Python path
ENV PYTHONPATH=/app

# Set environment variables for worker
ENV RAY_WORKER=true
ENV RAY_DISABLE_IMPORT_WARNING=1

# Default command (requires RAY_HEAD_ADDRESS environment variable)
CMD ["python", "distributed_ga/scripts/start_worker.py", "--address", "${RAY_HEAD_ADDRESS}", "--auto-reconnect"]